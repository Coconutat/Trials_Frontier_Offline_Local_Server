            "name": "triag_an_lnch61_a_ws",
            "friendlyName": "triag_an_lnch61_a_ws",
            "url": "http://127.0.0.1:8000/"
          }
        },
        "Anticheating_Enabled": false,
        "setOnlineConfigured": true
      }
    }
  },

